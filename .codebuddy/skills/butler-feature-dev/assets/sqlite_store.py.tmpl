# ai-butler 模板：engine SQLite 适配器（按域一文件）
# 用法：另存为 packages/engine/src/butler_engine/<域>/sqlite.py，实现对应 core 端口。
#       改表后必须跑 python scripts/dump_db_schema.py 同步 db/schema.sql。

"""<域> 存储（A2-0<分册号> §<节>）：SQLite(WAL) 单库、每操作一连接、<排序契约>。"""

from __future__ import annotations

import sqlite3
from contextlib import closing
from pathlib import Path

from butler_core.<域>.domain import <Entity>
from butler_core.<域>.ports import <Store>

_SCHEMA = """
CREATE TABLE IF NOT EXISTS <table> (
    account_id TEXT NOT NULL,
    record_id  TEXT NOT NULL,
    -- 业务字段（歧义字段加业务前缀；时序表时间字段用业务语义名）
    ts TEXT NOT NULL,
    PRIMARY KEY (account_id, record_id)      -- 复合主键 = 应用侧幂等（主键应用侧生成）
);
CREATE INDEX IF NOT EXISTS idx_<table>_ts ON <table> (account_id, ts);
"""


class Sqlite<Store>(<Store>):
    """实现 core <Store> 端口；<一句话不变量>。"""

    def __init__(self, db_path: Path) -> None:
        self._db_path = db_path

    def _connect(self) -> sqlite3.Connection:
        conn = sqlite3.connect(self._db_path)
        conn.row_factory = sqlite3.Row
        conn.executescript(_SCHEMA)          # 幂等 DDL，每次连接兜底
        return conn

    def append_<entity>(self, entity: <Entity>) -> None:
        with closing(self._connect()) as conn, conn:
            conn.execute(
                "INSERT OR REPLACE INTO <table> (...) VALUES (...)",
                (...),
            )

    def list_<entities>(self, account_id: str, *, limit: int = 50) -> list[<Entity>]:
        if limit <= 0:                       # 分页守卫在 store 层
            return []
        with closing(self._connect()) as conn:
            rows = conn.execute(
                "SELECT * FROM <table> WHERE account_id = ? ORDER BY ts DESC LIMIT ?",
                (account_id, limit),
            ).fetchall()
        return [self._to_entity(r) for r in rows]

    @staticmethod
    def _to_entity(row: sqlite3.Row) -> <Entity>:
        return <Entity>(...)
